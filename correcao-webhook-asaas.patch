@@ -144,6 +144,19 @@ class TestSandboxInbox(unittest.IsolatedAsyncioTestCase):
             self.assertEqual(result['invoice_id'],'inv-1')
             self.assertEqual((await db.get(PaymentInvoice,'inv-1')).status,'PENDING')
 
+    async def test_official_event_id_with_ampersand_is_accepted_idempotently(self):
+        # Exemplo oficial da documentacao do Asaas: o id do evento contem "&".
+        body={'id':'evt_05b708f961d739ea7eba7e4db318f621&368604920','event':'PAYMENT_RECEIVED','dateCreated':'2024-06-12 16:45:03','payment':{'object':'payment','id':'pay_080225913252'}}
+        first=await self.client.post('/api/webhooks/asaas',headers=self.headers(),json=body)
+        self.assertEqual(first.status_code,200); self.assertTrue(first.json()['recorded'])
+        again=await self.client.post('/api/webhooks/asaas',headers=self.headers(),json=body)
+        self.assertEqual(again.status_code,200); self.assertFalse(again.json()['recorded'])
+        async with self.sessions() as db:
+            events=(await db.execute(select(AsaasWebhookInbox))).scalars().all()
+            self.assertEqual(len(events),1)
+            self.assertTrue(events[0].event_id.startswith('evt_05b708f961d739ea7eba7e4db318f621'))
+            self.assertNotIn('&',events[0].event_id)
+            self.assertEqual(events[0].status,'PENDING_REVIEW')
+
 
 if __name__ == '__main__': unittest.main()
