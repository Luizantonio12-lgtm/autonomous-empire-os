# ==========================================================
# AUTONOMOUS BUSINESS EMPIRE v2.0 — CONFIGURAÇÃO DE PRODUÇÃO
# ==========================================================

# Base de Dados Principal (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql+asyncpg://empire_admin:empire_secret_2026@localhost:5432/autonomous_empire

# Barramento de Eventos & Filas em Tempo Real (Redis 7)
REDIS_URL=redis://localhost:6379/0

# Router Multi-LLM (Cascata OpenAI -> Anthropic -> DeepSeek)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEFAULT_LLM_STRATEGY=MARGIN_OPTIMIZED

# Isolamento & Deploy Externo da Fábrica de Software Nível 2
E2B_API_KEY=e2b_...
VERCEL_TOKEN=vcp_...
FLY_API_TOKEN=fo1_...
SANDBOX_MAX_HEALING_ITERATIONS=5

# Gateways Financeiros Reais (Stripe Internacional + Asaas Pix/Boleto BR)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
ASAAS_API_KEY=$aact_...
ASAAS_WEBHOOK_TOKEN=empire_asaas_secret
ASAAS_BASE_URL=https://api.asaas.com/v3

# Integração Omnicanal Suporte 24h & Pareamento QR WhatsApp (Evolution API v2)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=empire_evo_master_key
EVOLUTION_INSTANCE_NAME=empire-hq
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_...
