+            async def __aexit__(self,*args): pass
+            async def get(self,url,**kwargs): return Resp()
+        owner={'origin':'https://empire.test','cookie':'empire_admin=valid'}
+        with patch('main.valid_session',side_effect=lambda value: value=='valid'):
